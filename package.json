{
  "name": "ankit-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "yarn install --immutable",
    "dev": "yarn pwa:build && yarn demo:build && node node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "yarn pwa:build && yarn demo:build && node node_modules/next/dist/bin/next build && yarn studio:build && node scripts/package-studio.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "demo:build": "node scripts/build-demo.mjs",
    "demo:sync": "node scripts/sync-renderer.mjs",
    "lint:fix": "node node_modules/eslint/bin/eslint.js . --max-warnings 0 --fix",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src scripts/build-demo.mjs scripts/sync-renderer.mjs scripts/serve-static.mjs scripts/build-pwa.mjs scripts/package-studio.mjs *.json *.mjs *.ts README.md docs",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src scripts/build-demo.mjs scripts/sync-renderer.mjs scripts/serve-static.mjs scripts/build-pwa.mjs scripts/package-studio.mjs *.json *.mjs *.ts README.md docs",
    "studio": "node node_modules/sanity/bin/sanity dev --host 127.0.0.1 --port 3333",
    "studio:build": "node node_modules/sanity/bin/sanity build studio-dist",
    "pwa:build": "node scripts/build-pwa.mjs"
  },
  "dependencies": {
    "@dhaiwat10/react-link-preview": "^1.15.0",
    "@emailjs/browser": "^4.4.1",
    "@portabletext/react": "^8.0.1",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@sanity/client": "^8.7.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.31.0",
    "masonry-layout": "^4.2.2",
    "next": "16.3.4",
    "next-intl": "^4.14.7",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "styled-components": "6.5.3",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/masonry-layout": "^4.2.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.9",
    "sanity": "^6.16.0",
    "sharp": "^0.35.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "src/demos/json-renderer"
  ],
  "optionalDependencies": {
    "node-win-x64": "24.19.0"
  }
}
