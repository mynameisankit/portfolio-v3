{
  "cleanUrls": true,
  "directoryListing": false,
  "rewrites": [
    {
      "source": "/studio/**",
      "destination": "/studio/index.html"
    }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
